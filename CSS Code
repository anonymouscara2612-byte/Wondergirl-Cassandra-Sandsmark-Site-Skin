.splash .favorite li:nth-of-type(2n+2) a:hover::before {
  content: " 💥  ";
  color: transparent !important;
  text-shadow: 0 0 0 #D6DCE5;
}

.splash .favorite {
  position: relative;
  padding-bottom: 22px;
}

.splash .favorite::before {
  content: "";
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-30%);
  width: 55px;
  height: 100px;
  background-image: url("https://64.media.tumblr.com/79e0ba5ecd9884b402ca49eadfe253e7/c2fa978f7326c710-a2/s1280x1920/fea5aa5255f338667f879ee4dfc18515b769dcc4.png");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

.splash .favorite {
  position: relative;
}

.splash .favorite::after {
  content: " 𝑯𝒆𝒚, 𝑴𝒓. 𝒁𝒆𝒖𝒔! '𝑺𝒄𝒖𝒔𝒆 𝒎𝒆, 𝒚𝒐𝒖𝒓 𝒈𝒐𝒅𝒔𝒉𝒊𝒑, 𝒃𝒖𝒕 𝑰 𝒏𝒆𝒆𝒅 𝒕𝒐 𝒕𝒂𝒍𝒌 𝒕𝒐 𝒚𝒐𝒖! ";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  transform: translateY(15px);
  border-radius: 10px;
  background: rgba(21, 9, 9, 0.7);
  text-align: center;
  font-size: 11px;
  color: #E2DCC0;
  opacity: 1;
  white-space: pre;
}

